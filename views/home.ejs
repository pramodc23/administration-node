        <h1>Welcome to the Home Page</h1>
        
        <div class="button-container">
            <a href="#" class="btn" id="teacherBtn">Teacher</a>
        </div>

        <div id="teacherList">
            <h2>Teacher List</h2>
            <ul id="teachers"></ul>
        </div>
    </div>

    <script>
